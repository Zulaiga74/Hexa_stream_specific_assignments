import pandas as pd

df = pd.read_csv("final_college_student_placement_dataset.csv")
# print(len(df.columns))

# 1. Categorize placed students into salary bands:
    # Low: < 300,000
    # Medium: 300,000 – 600,000
    # High: > 600,000
    
def placed(salary):
    if pd.isna(salary):
        return "Unknown"
    elif salary < 300000:
        return "Low"
    elif 300000<= salary < 600000:
        return "Medium"
    else:
        return "High"
    
df['Salary'] = pd.to_numeric(df['Salary'], errors='coerce')
df["Placed_Categorized_BySalary"] = df['Salary'].apply(placed)
print(len(df.columns))
print(df["Placed_Categorized_BySalary"].head(20))

# 2. For each gender and specialization, calculate:
    # Placement rate
    # Average salary (only placed)
    # Avg MBA score

gender_specialization_status = df.groupby(['Gender','Specialization']).agg(
    rate_placement = ('Placement',lambda x:(x == 'Yes').mean()),
    avg_mba = ('MBA_Percentage','mean')
)
print(gender_specialization_status)

