# 14. Get total number of placed and unplaced students.
placed_count = df['Placement'].value_counts()
print(placed_count)

# 15.For each specialization, calculate:
    # Average SSC
    # Average MBA
    # Placement count
    
df['SSC_Percentage'] = pd.to_numeric(df['SSC_Percentage'], errors='coerce')
df['MBA_Percentage'] = pd.to_numeric(df['MBA_Percentage'], errors='coerce')
spec_stats = df.groupby('Specialization').agg(
    avg_ssc =('SSC_Percentage','mean'),
    avg_mba =('MBA_Percentage','mean'),
    placement_cnt=('Placement',lambda x:(x=='Yes').sum())
)
print(spec_stats)

# 16. Summary table: Nulls, uniques, duplicate counts
summary_table = pd.DataFrame({
    'Column': df.columns,
    'Nullcount': df.isnull().sum().values,
    'Uniquecount': df.nunique().values,
    'Duplicount': [df.duplicated(subset=col).sum() if df[col].duplicated().any() else 0 for col in df.columns]
})
print(summary_table)







